{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "loc-voi",
  "framework": null,

  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },

  "rewrites": [
    {
      "source": "/",
      "destination": "/index.php"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.php"
    },
    {
      "source": "/customer",
      "destination": "/customer/dashboard.php"
    }
  ],

  "redirects": [
    {
      "source": "/includes/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/database.sql",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.htaccess",
      "destination": "/",
      "permanent": false
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
