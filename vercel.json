{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "loc-voi",
  "framework": null,
  "functions": {
    "index.php": { "runtime": "vercel-php@0.9.0" },
    "login.php": { "runtime": "vercel-php@0.9.0" },
    "register.php": { "runtime": "vercel-php@0.9.0" },
    "logout.php": { "runtime": "vercel-php@0.9.0" },
    "cars.php": { "runtime": "vercel-php@0.9.0" },
    "car-details.php": { "runtime": "vercel-php@0.9.0" },
    "booking.php": { "runtime": "vercel-php@0.9.0" },
    "payment.php": { "runtime": "vercel-php@0.9.0" },
    "contact.php": { "runtime": "vercel-php@0.9.0" },
    "about.php": { "runtime": "vercel-php@0.9.0" },
    "terms.php": { "runtime": "vercel-php@0.9.0" },
    "contract.php": { "runtime": "vercel-php@0.9.0" },
    "contract-modern.php": { "runtime": "vercel-php@0.9.0" },
    "forgot-password.php": { "runtime": "vercel-php@0.9.0" },
    "reset-password.php": { "runtime": "vercel-php@0.9.0" },
    "verify-email.php": { "runtime": "vercel-php@0.9.0" },
    "install.php": { "runtime": "vercel-php@0.9.0" },
    "add-all-cars.php": { "runtime": "vercel-php@0.9.0" },
    "seed-cars.php": { "runtime": "vercel-php@0.9.0" },
    "create-admin.php": { "runtime": "vercel-php@0.9.0" },
    "admin/**.php": { "runtime": "vercel-php@0.9.0" },
    "customer/**.php": { "runtime": "vercel-php@0.9.0" },
    "api/**.php": { "runtime": "vercel-php@0.9.0" },
    "includes/**.php": { "runtime": "vercel-php@0.9.0" }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.php" },
    { "source": "/admin", "destination": "/admin/index.php" },
    { "source": "/customer", "destination": "/customer/dashboard.php" }
  ],
  "redirects": [
    { "source": "/includes/:path*", "destination": "/", "permanent": false },
    { "source": "/database.sql", "destination": "/", "permanent": false },
    { "source": "/README.md", "destination": "/", "permanent": false },
    { "source": "/.htaccess", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
